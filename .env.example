# Claude (https://console.anthropic.com). Without it the app uses an offline rule-based agent.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
CLAUDE_MODEL=

# PayPal sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox).
# Without these the app simulates PayPal locally.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

PORT=3000
CHAT_LIMIT_PER_HOUR=40
REPO_URL=https://github.com/sanjaysaini383/paypal

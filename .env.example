# ---------------------------------------------------------------- AI model
# Set ONE AI key. The first one found is used (or force one with AI_PROVIDER).
# With no key, the app runs an offline rule-based agent.

# Google Gemini: free tier, recommended free option. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (https://console.groq.com/keys). Free tier, but low tokens-per-minute limits.
GROQ_API_KEY=
# OpenRouter (https://openrouter.ai/keys). Needs AI_MODEL, e.g. a model id ending in ":free".
OPENROUTER_API_KEY=
# Optional: claude | gemini | groq | openrouter | openai | offline
AI_PROVIDER=
# Optional model override (defaults: gemini-3.8-flash, openai/gpt-oss-120b)
AI_MODEL=
# Optional: any other OpenAI-compatible endpoint (use with AI_PROVIDER=openai and AI_API_KEY)
AI_BASE_URL=
AI_API_KEY=
# Optional: minimal | low | medium | high (default "low" for Gemini)
AI_REASONING_EFFORT=

# PayPal sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox).
# Without these the app simulates PayPal locally.
PAYPAL_CLIENT_ID= 
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

PORT=3000
CHAT_LIMIT_PER_HOUR=40
REPO_URL=
